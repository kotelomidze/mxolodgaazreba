  "sourceFile": "გააზრება, 171 (ლებანიძე, ლეგენდად დარჩეს).pdf",
  "sections": [
    {
      "id": "part-1",
      "title": "ნაწილი 1",
      "subtitle": "ტექსტის პირველი გვერდი",
      "stanzas": [
        [
          "ტიციანს",
          "თავის პოეტებში ჰქონია სუფრა,",
          "და იჯდა თურმე",
          "ჩვენი დენდი საერთო ჯამთან -",
          "უხორცო იყო,",
          "ცოტას სვამდა და ცოტას ჭამდა;",
          "გალაკტიონი",
          "შემოსულა დუქანში ამ დროს,",
          "მარტო დამჯდარა,",
          "მარტოსული, და უსვამს მარტოს;",
          "არ მიუხმია",
          "ის ტიციანს, არა და არა,",
          "და ასე უბრად,",
          "უხერხულად კარგა ხანს მსხდარან.",
          "უცებ... (მახლობლად",
          "პურს ნაჭამა რეგვნების ჯგუფი)",
          "პოეტი მეფე",
          "ვერც მიმხვდარა რატომ და რისთვის, -",
          "უკადრებია",
          "რეგვენს სიტყვა რეგვნული მისთვის...",
          "აჰფეთქებია",
          "აქ ტიციანს უეცრად დენთი,",
          "წამოვარდნილა",
          "ჩვენი ლორდი და ჩვენი დენდი,",
          "დაუდგამს ჭიქა,",
          "შეუხსნია კისერზე ბანტი",
          "და უხეთქია",
          "რეგვნულ შუბლში",
          "რეგვნისთვის კვარტი.",
          "და დარევიან",
          "პოეტები ერთპირად რეგვნებს",
          "და ჭახაჭუხი",
          "შესდგომიათ ბოთლებს და ნეკნებს;",
          "და როცა ჩვენი",
          "ლომკაცები ბრძოლით გამძღარან,",
          "დაუფრენიათ",
          "თხებივით და, ომი დამცხრალა,",
          "- ტიტე, ძამიკო! -",
          "შეშლილივით აყვირებულა",
          "გალაკტიონი",
          "და ორთავე ატირებულა...",
          "ორპირის ფშანზე",
          "გაზრდილ ბიჭებს უეცრად გული",
          "ამოსჯდომიათ,",
          "ხვევნა-კოცნა შექმნილა ძმური;",
          "გადმოსცვენია",
          "შვების ცრემლი ტიციანს მისით,",
          "რაც ექნებოდათ",
          "სამდურავი იციან, ვიცით!",
          "დიდი ბავშვები!",
          "ამდგარან და დამსხდარან ერთად",
          "და პოეზია",
          "უთქვამთ პირველ",
          "საერთო ღმერთად.",
          "პაოლოს გარდა",
          "ამ საქმეში ყოფილა გოგლა,",
          "ყოფილა სმა და",
          "გადარევა ყოფილა ოხრად.",
          "ეს ყველაფერი",
          "მე მიამბო „არაგვში“ გალამ",
          "და, თუ ვუმატებ,",
          "ანუ ვაკლებ, ან რამეს ვმალავ,",
          "არამი იყოს",
          "ის წარწერა: „სულით და გულით!“",
          "იქ, იმ სარდაფში",
          "მიღებული ღვინო და პური!",
          "გული გულს იცნობს,",
          "ღონე ღონეს, მარჯვენი მარჯვენს...",
          "ლეგენდად დარჩეს,",
          "მეგობრებო, ლეგენდად დარჩეს!"
        ]
      ]
    },
    {
      "id": "part-3",
      "title": "ნაწილი 3",
      "subtitle": "ტექსტის მესამე გვერდი",
      "stanzas": [
        [
          "რა ინფორმაციით იწყებს ავტორი ამბის თხრობას?",
          "ა) გალაკტიონი და ტიციანი ერთად შევიდნენ დუქანში.",
          "ბ) გალაკტიონი და ტიციანი ერთმანეთს არ ელაპარაკებოდნენ.",
          "გ) გალაკტიონი და ტიციანი მეგობრებთან ერთად ქეიფობდნენ.",
          "დ) გალაკტიონი და ტიციანი „რეგვნებს“ ერთად შეებრძოლნენ."
        ]
      ]
    },
    {
      "id": "part-4",
      "title": "ნაწილი 4",
      "subtitle": "ტექსტის მეოთხე გვერდი",
      "stanzas": [
        [
          "ვის გულისხმობს ავტორი ფრაზაში: „თავის პოეტებში ჰქონია სუფრა“?",
          "ა) არისტოკრატებს.",
          "ბ) დადაისტებს.",
          "გ) თაყვანისმცემლებს.",
          "დ) ცისფერყანწელებს."
        ]
      ]
    },
    {
      "id": "part-5",
      "title": "ნაწილი 5",
      "subtitle": "ტექსტის მეხუთე გვერდი",
      "stanzas": [
        [
          "რომელი სიტყვებით მიუთითებს ავტორი იმ პოეტის არტისტულ ბუნებაზე, რომელსაც საზოგადოებაში",
          "გამოჩენისას წითელი მიხაკი ჰქონდა ხოლმე მკერდზე დამაგრებული?",
          "ა) „უხორცო იყო“.",
          "ბ) „ჩვენი დენდი“.",
          "გ) „ცოტას სვამდა“.",
          "დ) „ცოტას ჭამდა“."
        ]
      ]
    },
    {
      "id": "part-6",
      "title": "ნაწილი 6",
      "subtitle": "ტექსტის მეექვსე გვერდი",
      "stanzas": [
        [
          "რომელი სიტყვით ახასიათებს ავტორი გალაკტიონს?",
          "ა) „დენდი“.",
          "ბ) „მარტოსული“.",
          "გ) „ლომკაცი“.",
          "დ) „ლორდი“."
        ]
      ]
    },
    {
      "id": "part-7",
      "title": "ნაწილი 7",
      "subtitle": "ტექსტის 7 გვერდი",
      "stanzas": [
        [
          "როგორი ადამიანის დასახასიათებლად იყენებს ავტორი სიტყვას „რეგვენი“?",
          "ა) რომელმაც არ იცის გალაკტიონის ფასი.",
          "ბ) რომელმაც არ იცის მეგობრების პატივისცემა.",
          "გ) რომელსაც არა აქვს დროსტარების უნარი.",
          "დ) რომელსაც არ შეუძლია თავის გაწირვა."
        ]
      ]
    },
    {
      "id": "part-8",
      "title": "ნაწილი 8",
      "subtitle": "ტექსტის 8 გვერდი",
      "stanzas": [
        [
          "ტიციანის რა რეაქცია მოჰყვა „რეგვნის“ საქციელს?",
          "ა) აღშფოთება.",
          "ბ) გაოცება.",
          "გ) კმაყოფილება.",
          "დ) შეშინება."
        ]
      ]
    },
    {
      "id": "part-9",
      "title": "ნაწილი 9",
      "subtitle": "ტექსტის 9 გვერდი",
      "stanzas": [
        [
          "რა გააკეთა ტიციანმა „რეგვნის“ მოქმედების საპასუხოდ?",
          "ა) აიძულა ბოდიში მოეხადა.",
          "ბ) ბოთლი ჩაარტყა თავში.",
          "გ) კისრიდან ბანტი ჩამოჰგლიჯა.",
          "დ) უკადრისი სიტყვებით გალანძღა."
        ]
      ]
    },
    {
      "id": "part-10",
      "title": "ნაწილი 10",
      "subtitle": "ტექსტის 10 გვერდი",
      "stanzas": [
        [
          "რა მოჰყვა ტიციანის საქციელს?",
          "ა) გალაკტიონმა იქაურობა დატოვა.",
          "ბ) დიდი ჩხუბი ატყდა.",
          "გ) პოეტები გაიქცნენ.",
          "დ) დუქანი დაიკეტა."
        ]
      ]
    },
    {
      "id": "part-11",
      "title": "ნაწილი 11",
      "subtitle": "ტექსტის 11 გვერდი",
      "stanzas": [
        [
          "რას გულისხმობს ავტორი სიტყვებით: „ომი დამცხრალა“?",
          "ა) ნადიმი დასრულდა.",
          "ბ) პოეტები დამარცხდნენ.",
          "გ) „რეგვნები“ გაიქცნენ.",
          "დ) ჩხუბი დამთავრდა."
        ]
      ]
    },
    {
      "id": "part-12",
      "title": "ნაწილი 12",
      "subtitle": "ტექსტის 12 გვერდი",
      "stanzas": [
        [
          "რომელ მხატვრულ საშუალებას იყენებს ავტორი ფრაზაში: „შეშლილივით აყვირებულა გალაკტიონი და ორთავე",
          "ატირებულა“?",
          "ა) გაპიროვნებას.",
          "ბ) მეტაფორას.",
          "გ) შედარებას.",
          "დ) ჰიპერბოლას."
        ]
      ]
    },
    {
      "id": "part-13",
      "title": "ნაწილი 13",
      "subtitle": "ტექსტის 13 გვერდი",
      "stanzas": [
        [
          "რა დადებითი შედეგი მოჰყვა დუქანში გამართულ ჩხუბს?",
          "ა) დამდურებული ნათესავები შერიგდნენ.",
          "ბ) პოეზია უპირველეს ღმერთად აღიარეს.",
          "გ) პოეტები რეპრესიებს გადაურჩნენ.",
          "დ) პოეტები ცნობილნი გახდნენ."
        ]
      ]
    },
    {
      "id": "part-14",
      "title": "ნაწილი 14",
      "subtitle": "ტექსტის 14 გვერდი",
      "stanzas": [
        [
          "რომელ ფრაზაში იყენებს ავტორი მეტაფორას?",
          "ა) „არამი იყოს ის წარწერა: „სულით და გულით!“",
          "ბ) „აჰფეთქებია აქ ტიციანს უეცრად დენთი“.",
          "გ) „დაუდგამს ჭიქა, შეუხსნია კისერზე ბანტი“.",
          "დ) „ლეგენდად დარჩეს, მეგობრებო, ლეგენდად დარჩეს“."
        ]
      ]
    },
    {
      "id": "part-15",
      "title": "ნაწილი 15",
      "subtitle": "ტექსტის 15 გვერდი",
      "stanzas": [
        [
          "ცნობილი პოეტების რომელ თვისებებზე მიგვანიშნებს ავტორი, როდესაც მათ „დიდ ბავშვებს“ უწოდებს?",
          "ა) მიამიტობასა და გულწრფელობაზე.",
          "ბ) მიმტევებლობასა და თავმდაბლობაზე.",
          "გ) სიმამაცესა და თავგანწირვაზე.",
          "დ) სიამაყესა და მედიდურობაზე."
        ]
      ]
    },
    {
      "id": "part-16",
      "title": "ნაწილი 16",
      "subtitle": "ტექსტის 16 გვერდი",
      "stanzas": [
        [
          "რის შესახებ არ არის საუბარი ამ ტექსტში?",
          "ა) თვითმკვლელობის.",
          "ბ) ნამდვილი მეგობრობის.",
          "გ) პოეზიის უზენაესობის.",
          "დ) ურთიერთდახმარების."
        ]
      ]
    },
    {
      "id": "part-17",
      "title": "ნაწილი 17",
      "subtitle": "ტექსტის 17 გვერდი",
      "stanzas": [
        [
          "რა არის ავტორის მთავარი სათქმელი?",
          "ა) გალაკტიონი და ტიციანი დიდი პოეტები იყვნენ.",
          "ბ) გალაკტიონი და ტიციანი ნამდვილი პატრიოტები იყვნენ.",
          "გ) გალაკტიონსა და ტიციანს განსხვავებული შეხედულებები ჰქონდათ.",
          "დ) გალაკტიონსა და ტიციანს გულწრფელად უყვარდათ ერთმანეთი."
        ]
      ]
    }
  ],
